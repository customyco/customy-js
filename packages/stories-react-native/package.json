{
  "name": "@customyai/stories-react-native",
  "version": "0.2.0",
  "description": "Customy Stories for React Native: story bar, full-screen viewer, banners, provider and hooks (plus headless mode) on the pure core of @customyai/stories-render. Reanimated + Gesture Handler as peers; video, media cache, storage and Lottie are injectable. Optional modules: widgets (Canvas, Swipe Cards, Checklist, Tour, Inline), video-feed, game, ugc and live (live streams; the LiveKit client is injected, never a dependency).",
  "license": "MIT",
  "author": "Customy <hello@customy.ai>",
  "homepage": "https://docs.customy.ai/sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/customyco/customy-js.git",
    "directory": "packages/stories-react-native"
  },
  "bugs": {
    "url": "https://github.com/customyco/customy-js/issues"
  },
  "keywords": [
    "customy",
    "stories",
    "react-native",
    "reanimated"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./components": {
      "import": {
        "types": "./dist/components/index.d.ts",
        "default": "./dist/components/index.mjs"
      },
      "require": {
        "types": "./dist/components/index.d.cts",
        "default": "./dist/components/index.cjs"
      }
    },
    "./video": {
      "import": {
        "types": "./dist/video/index.d.ts",
        "default": "./dist/video/index.mjs"
      },
      "require": {
        "types": "./dist/video/index.d.cts",
        "default": "./dist/video/index.cjs"
      }
    },
    "./lottie": {
      "import": {
        "types": "./dist/lottie/index.d.ts",
        "default": "./dist/lottie/index.mjs"
      },
      "require": {
        "types": "./dist/lottie/index.d.cts",
        "default": "./dist/lottie/index.cjs"
      }
    },
    "./storage": {
      "import": {
        "types": "./dist/storage/index.d.ts",
        "default": "./dist/storage/index.mjs"
      },
      "require": {
        "types": "./dist/storage/index.d.cts",
        "default": "./dist/storage/index.cjs"
      }
    },
    "./widgets": {
      "import": {
        "types": "./dist/widgets/index.d.ts",
        "default": "./dist/widgets/index.mjs"
      },
      "require": {
        "types": "./dist/widgets/index.d.cts",
        "default": "./dist/widgets/index.cjs"
      }
    },
    "./video-feed": {
      "import": {
        "types": "./dist/video-feed/index.d.ts",
        "default": "./dist/video-feed/index.mjs"
      },
      "require": {
        "types": "./dist/video-feed/index.d.cts",
        "default": "./dist/video-feed/index.cjs"
      }
    },
    "./game": {
      "import": {
        "types": "./dist/game/index.d.ts",
        "default": "./dist/game/index.mjs"
      },
      "require": {
        "types": "./dist/game/index.d.cts",
        "default": "./dist/game/index.cjs"
      }
    },
    "./ugc": {
      "import": {
        "types": "./dist/ugc/index.d.ts",
        "default": "./dist/ugc/index.mjs"
      },
      "require": {
        "types": "./dist/ugc/index.d.cts",
        "default": "./dist/ugc/index.cjs"
      }
    },
    "./live": {
      "import": {
        "types": "./dist/live/index.d.ts",
        "default": "./dist/live/index.mjs"
      },
      "require": {
        "types": "./dist/live/index.d.cts",
        "default": "./dist/live/index.cjs"
      }
    },
    "./live-livekit": {
      "import": {
        "types": "./dist/live-livekit/index.d.ts",
        "default": "./dist/live-livekit/index.mjs"
      },
      "require": {
        "types": "./dist/live-livekit/index.d.cts",
        "default": "./dist/live-livekit/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "components": [
        "./dist/components/index.d.ts"
      ],
      "video": [
        "./dist/video/index.d.ts"
      ],
      "lottie": [
        "./dist/lottie/index.d.ts"
      ],
      "storage": [
        "./dist/storage/index.d.ts"
      ],
      "widgets": [
        "./dist/widgets/index.d.ts"
      ],
      "video-feed": [
        "./dist/video-feed/index.d.ts"
      ],
      "game": [
        "./dist/game/index.d.ts"
      ],
      "ugc": [
        "./dist/ugc/index.d.ts"
      ],
      "live": [
        "./dist/live/index.d.ts"
      ],
      "live-livekit": [
        "./dist/live-livekit/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@customyai/stories-render": "^0.2.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.79",
    "react-native-gesture-handler": "^2.20.0",
    "react-native-reanimated": "^3.16.0 || ^4.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "19.0.0",
    "jsdom": "24.1.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "^2.33.0",
    "react-native-reanimated": "^4.7.0",
    "react-native-worklets": "^0.13.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
