{
  "name": "@customyai/stories-embed",
  "version": "0.2.0",
  "description": "Customy Stories embed: self-contained bundle (ESM + IIFE <script>) built from @customyai/stories-render for WebView and bundler-less sites, with a versioned, strictly validated native message bridge (iOS, Android, React Native, Flutter, Unity, iframe). Heavy modules (components, lottie, game, video, live, ads) load lazily.",
  "license": "MIT",
  "author": "Customy <hello@customy.ai>",
  "homepage": "https://docs.customy.ai/sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/customyco/customy-js.git",
    "directory": "packages/stories-embed"
  },
  "bugs": {
    "url": "https://github.com/customyco/customy-js/issues"
  },
  "keywords": [
    "customy",
    "stories",
    "embed",
    "webview",
    "iife"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "default": "./dist/protocol.mjs"
    },
    "./iife": "./dist/iife/customy-stories-embed.js",
    "./embed.css": "./dist/iife/customy-stories-embed.css",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "protocol": [
        "./dist/protocol.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && node scripts/build-esm.mjs && tsup && node scripts/build-iife.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@customyai/stories-render": "^0.2.0"
  },
  "devDependencies": {
    "jsdom": "24.1.3",
    "lottie-web": "5.13.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  }
}
