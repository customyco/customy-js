{
  "name": "@customyai/send-sdk",
  "version": "1.6.3",
  "description": "Deprecated: use @customyai/send. Adapter of the Customy Send client (email API and Customy Engage: push, in-app inbox and in-app messages) kept for one major cycle.",
  "license": "MIT",
  "homepage": "https://send-api.customy.ai/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/customyco/customy-js.git",
    "directory": "packages/send-sdk"
  },
  "bugs": {
    "url": "https://github.com/customyco/customy-js/issues"
  },
  "keywords": [
    "email",
    "transactional",
    "customy",
    "resend",
    "smtp",
    "dkim",
    "push",
    "notifications",
    "inbox",
    "in-app",
    "react-native"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./inbox": {
      "import": {
        "types": "./dist/inbox.d.ts",
        "default": "./dist/inbox.mjs"
      },
      "require": {
        "types": "./dist/inbox.d.cts",
        "default": "./dist/inbox.cjs"
      }
    },
    "./inbox/react": {
      "import": {
        "types": "./dist/inbox/react.d.ts",
        "default": "./dist/inbox/react.mjs"
      },
      "require": {
        "types": "./dist/inbox/react.d.cts",
        "default": "./dist/inbox/react.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "inbox": [
        "./dist/inbox.d.ts"
      ],
      "inbox/react": [
        "./dist/inbox/react.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@customyai/core": "^0.2.0",
    "@customyai/send": "^0.7.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^4.1.11",
    "tsup": "^8.4.0",
    "@types/node": "^20.14.2",
    "@types/react": "^19.0.0",
    "react": "19.2.8"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
