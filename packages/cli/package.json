{
  "name": "@customyai/cli",
  "version": "0.1.0",
  "description": "Customy CLI for apps: validate, type and sync customy.app.json (customy apps validate | codegen | sync). Also usable as a library.",
  "license": "MIT",
  "author": "Customy <hello@customy.ai>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/customyco/customy-js.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/customyco/customy-js/issues"
  },
  "keywords": [
    "customy",
    "cli",
    "manifest",
    "codegen",
    "sdk"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "customy": "./dist/bin.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^4.1.11",
    "tsup": "^8.0.0",
    "@types/node": "^20.14.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
