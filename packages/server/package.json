{
  "name": "@customyai/server",
  "version": "0.2.0",
  "description": "Customy identity verification for any server: JWKS with rotation, machine and user token verifiers, BFF actor assertions and request verification over the standard Request, with a Node IncomingMessage adapter. Server only.",
  "license": "MIT",
  "author": "Customy <hello@customy.ai>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/customyco/customy-js.git",
    "directory": "packages/server"
  },
  "bugs": {
    "url": "https://github.com/customyco/customy-js/issues"
  },
  "keywords": [
    "customy",
    "sdk",
    "jwt",
    "jwks",
    "auth",
    "server"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "edge-light": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "workerd": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "worker": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "browser": null,
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@customyai/core": "^0.2.0",
    "jose": "^5.2.2"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^4.1.11",
    "tsup": "^8.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
