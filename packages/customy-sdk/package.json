{
  "name": "@customyai/customy-sdk",
  "version": "0.5.5",
  "description": "Deprecated: use @customyai/sdk. Adapter of the Customy umbrella SDK (createCustomy, portfolio clients) kept for one major cycle.",
  "license": "MIT",
  "author": "Customy <hello@customy.ai>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/customyco/customy-js.git",
    "directory": "packages/customy-sdk"
  },
  "bugs": {
    "url": "https://github.com/customyco/customy-js/issues"
  },
  "keywords": [
    "customy",
    "ai",
    "agent",
    "sdk",
    "api",
    "client"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.mjs"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "server": [
        "./dist/server.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@customyai/customy-access": "^0.9.3",
    "@customyai/links-sdk": "^0.3.1",
    "@customyai/sdk": "^0.13.0",
    "@customyai/send-sdk": "^1.6.3"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^4.1.11",
    "tsup": "^8.0.0",
    "@types/node": "^20.14.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
